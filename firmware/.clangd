## ─── clangd 언어 서버 설정 파일 ─────────────────────────────────────────────
## 파일: firmware/.clangd
##
## 목적:
##   ESP32-S3 / PlatformIO 멀티-환경 빌드에서 clangd(IntelliSense) 가짜 오류를
##   제거합니다. 아래 오류들은 실제 빌드(pio run) 오류가 아닌 IDE 전용 오류입니다:
##     - Unknown argument '-mlongcalls'
##     - '../hal.h' file not found
##     - Unknown type name 'PubSubClient', 'Adafruit_BME680' 등
##     - 'Cannot initialize object parameter of type Print' 등
##
## 원인:
##   clangd는 기본적으로 host(Windows) clang을 사용하므로:
##   1. Xtensa GCC 전용 컴파일러 플래그(-mlongcalls 등)를 알지 못합니다.
##   2. compile_commands.json의 include 경로에 Arduino/ESP-IDF 헤더가 없으면
##      PubSubClient, ArduinoJson, Adafruit 등 외부 라이브러리 타입을 인식 못합니다.
##   3. ESP32 Arduino 프레임워크 내부의 hal.h는 Xtensa GCC toolchain 전용입니다.
##
## 해결 방법:
##   1. compile_commands.json을 board1_gingerbread 환경으로 생성 (가장 많은 헤더 포함)
##   2. Xtensa 전용 알 수 없는 컴파일러 플래그를 일괄 Remove
##   3. 연쇄 오류 발생 헤더를 IncludeFilter로 차단
##   4. clangd가 ESP32 빌드 환경임을 인식하도록 핵심 매크로 강제 정의
## ──────────────────────────────────────────────────────────────────────────────

CompileFlags:
  # compile_commands.json 파일 위치 (firmware/ 루트 기준)
  # "pio run -e board1_gingerbread --target compiledb" 로 재생성한 파일을 사용합니다.
  # board1_gingerbread 환경은 가장 많은 라이브러리(BME680, PubSubClient, ArduinoJson)를
  # 포함하므로 모든 소스 파일의 헤더 경로를 가장 넓게 커버합니다.
  CompilationDatabase: .

  # Xtensa GCC 전용 플래그 제거 목록
  # clangd(host clang)이 인식하지 못해 연쇄 오류를 발생시키는 플래그들을 모두 제거합니다.
  # 실제 빌드(pio run)에는 전혀 영향이 없습니다.
  Remove:
    - -mlongcalls               # Xtensa 전용: 호출 범위 확장 플래그
    - -mtext-section-literals   # Xtensa 전용: 리터럴 배치 플래그
    - -fstrict-volatile-bitfields  # ESP-IDF 전용: volatile 비트필드 최적화
    - -fno-tree-switch-conversion  # GCC 전용: switch 최적화 억제
    - -fipa-pta                 # GCC 전용: 포인터 분석 IPA 플래그
    - -free                     # GCC 전용: 존재하지 않는 플래그
    - -ffunction-sections       # GCC/Clang 공용이나 일부 환경에서 경고 유발
    - -fdata-sections           # GCC/Clang 공용이나 일부 환경에서 경고 유발
    - --param                   # GCC 전용 파라미터 옵션 (값 포함 블록)
    - -march=rv32imac           # RISC-V 전용 플래그 (혼입 방지)
    - -mabi=ilp32               # RISC-V 전용 ABI 플래그

  # clangd가 Arduino/ESP32 빌드 환경임을 인식하도록 핵심 매크로 및 타겟 트레이너 지정
  Add:
    - --target=xtensa-esp32s3-elf # Windows SDK / MSVC 헤더 자동 수집 완전 차단
    - -DARDUINO=10819            # Arduino IDE 버전 식별 매크로 (1.8.19)
    - -DARDUINO_ARCH_ESP32       # ESP32 아키텍처 식별 매크로
    - -DESP32                    # ESP32 플랫폼 식별 매크로
    - -DESP_PLATFORM             # ESP-IDF 플랫폼 식별 매크로
    - -DARDUINO_USB_MODE=1       # ESP32-S3 USB 모드 매크로
    - -DARDUINO_USB_CDC_ON_BOOT=1  # ESP32-S3 CDC 부팅 매크로
    - -DCORE_DEBUG_LEVEL=0       # ESP32 Arduino 코어 디버그 레벨

    # ── Host (Windows SDK / MSVC) 헤더 차단 및 Xtensa GCC 툴체인 헤더 전용 지정 ──
    - -nostdinc
    - -nostdinc++
    - -isystemC:/Users/4996y/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include/c++/8.4.0
    - -isystemC:/Users/4996y/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include/c++/8.4.0/xtensa-esp32s3-elf
    - -isystemC:/Users/4996y/.platformio/packages/toolchain-xtensa-esp32s3/lib/gcc/xtensa-esp32s3-elf/8.4.0/include
    - -isystemC:/Users/4996y/.platformio/packages/toolchain-xtensa-esp32s3/lib/gcc/xtensa-esp32s3-elf/8.4.0/include-fixed
    - -isystemC:/Users/4996y/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include

Diagnostics:
  # clangd 진단 수준 설정
  # Xtensa 환경 불일치로 인한 연쇄 오류를 억제하여 실질적인 코드 오류에 집중합니다.
  UnusedIncludes: None          # 미사용 인클루드 경고 비활성화 (Arduino 환경 특수성)
  Suppress:
    - -Wunknown-warning-option  # 알 수 없는 경고 옵션 억제
    - pp_hash_error             # 전처리기 해시 오류 억제 (#error 지시어)
    - pp_file_not_found         # '../hal.h' 등 Xtensa 전용 헤더 누락 억제
    - no_member                 # MSVC/GCC ABI 불일치로 인한 멤버 미발견 억제
    - using_decl_conflict_reverse
  MissingIncludes: None         # 누락 인클루드 진단 비활성화 (플랫폼 헤더 누락 방지)

# clangd가 분석할 때 특정 파일 경로 패턴을 제외합니다.
# ESP32 SDK 내부 파일 분석 시 연쇄 오류가 발생하는 경로를 차단합니다.
PathMappings:
  # ESP32 Arduino 프레임워크 내부 hal.h 등은 분석하지 않습니다.
  # (Xtensa 전용 헤더로 host clang이 파싱할 수 없습니다)

InlayHints:
  # 인레이 힌트 설정 (코드 가독성 향상)
  Enabled: true
  ParameterNames: true           # 함수 호출 시 매개변수 이름 표시
  DeducedTypes: true             # auto 타입 추론 결과 표시
  BlockEnd: false                # 블록 끝 중괄호 힌트 비활성화 (과도한 노이즈 방지)
